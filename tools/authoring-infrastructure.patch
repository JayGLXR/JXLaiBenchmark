+// A Zero+251 leaf is the input aperture used by the experimental
+// jxl_from_tree fork. Its baseline residual is packed value 2, which decodes
+// to +1. With HybridUintConfig(1, 0, 0), the same singleton entropy symbol can
+// also decode to packed value 3 (-2) by changing one raw extra bit.
+constexpr pixel_type_w kInputApertureOffset = 251;
+
+Status GenerateModularChannelMAANS(Image *image, pixel_type chan,
+                                   const Tree &global_tree, Token **tokenpp,
+                                   size_t group_id) {
+  Channel &channel = image->channel[chan];
+  JxlMemoryManager *memory_manager = channel.memory_manager();
+  Token *tokenp = *tokenpp;
+
+  std::array<pixel_type, kNumStaticProperties> static_props = {
+      {chan, static_cast<int>(group_id)}};
+  bool use_wp;
+  bool is_wp_only;
+  bool is_gradient_only;
+  size_t num_props;
+  FlatTree tree = FilterTree(global_tree, static_props, &num_props, &use_wp,
+                             &is_wp_only, &is_gradient_only);
+  if (use_wp) {
+    return JXL_FAILURE("Input-aperture generation does not support WP trees");
+  }
+  // The large hash-machine tree uses many optional channels solely to raise
+  // the stock decoder's dynamic MA-tree limit. After filtering on the static
+  // channel property, each padding channel is exactly one Zero+0 leaf. Avoid
+  // evaluating the predictor and constructing properties for every one of
+  // those pixels; this is equivalent to the loop below, including its
+  // logical leaf context, but turns tens of millions of no-op visits into two
+  // linear fills.
+  if (tree.size() == 1 && tree[0].property0 == -1 &&
+      tree[0].predictor == Predictor::Zero &&
+      tree[0].predictor_offset == 0 && tree[0].multiplier == 1) {
+    const size_t count = channel.w * channel.h;
+    std::fill(tokenp, tokenp + count, Token(tree[0].childID, 0));
+    for (size_t y = 0; y < channel.h; ++y) {
+      std::fill_n(channel.Row(y), channel.w, static_cast<pixel_type>(0));
+    }
+    *tokenpp = tokenp + count;
+    return true;
+  }
+  MATreeLookup tree_lookup(tree);
+  Properties properties(num_props);
+  JXL_ASSIGN_OR_RETURN(
+      Channel references,
+      Channel::Create(memory_manager,
+                      properties.size() - kNumNonrefProperties, channel.w));
+  const ptrdiff_t onerow = channel.plane.PixelsPerRow();
+
+  for (size_t y = 0; y < channel.h; ++y) {
+    pixel_type *JXL_RESTRICT p = channel.Row(y);
+    PrecomputeReferences(channel, y, *image, chan, &references);
+    InitPropsRow(&properties, static_props, y);
+    for (size_t x = 0; x < channel.w; ++x) {
+      PredictionResult res =
+          PredictTreeNoWP(&properties, channel.w, p + x, onerow, x, y,
+                          tree_lookup, references);
+      const bool is_aperture =
+          res.predictor == Predictor::Zero &&
+          res.guess == kInputApertureOffset && res.multiplier == 1;
+      const uint32_t packed_residual = is_aperture ? 2 : 0;
+      *tokenp++ = Token(res.context, packed_residual);
+      p[x] = static_cast<pixel_type>(
+          res.guess + UnpackSigned(packed_residual) * res.multiplier);
+    }
+  }
+
+  *tokenpp = tokenp;
+  return true;
+}
+
